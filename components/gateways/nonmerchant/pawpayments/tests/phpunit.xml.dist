<?xml version="1.0" encoding="UTF-8"?>
<!-- stderr: validate() answers with header(), which fails once anything has
     been written to stdout; PHPUnit's own output would otherwise be that. -->
<phpunit bootstrap="bootstrap.php"
         stderr="true"
         colors="true"
         convertErrorsToExceptions="true"
         convertNoticesToExceptions="true"
         convertWarningsToExceptions="true">
    <testsuites>
        <testsuite name="PawPayments Blesta Gateway">
            <directory>.</directory>
        </testsuite>
    </testsuites>
</phpunit>
